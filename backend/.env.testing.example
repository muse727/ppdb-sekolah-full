# ==============================================================================
# P4-D.1 — Test environment template
#
#   cp env.testing.example .env.testing
#   # then edit DB_USERNAME / DB_PASSWORD to match your local test user
#
# `.env.testing` is gitignored, so it does NOT exist on a fresh clone or in CI.
# tests/bootstrap.php refuses to start the suite without it, because the
# fallback would be `.env` — which points at the production database
# `ppdb_sekolah` that RefreshDatabase (`migrate:fresh`) would drop.
#
# SAFETY MODEL
# ------------------------------------------------------------------------------
# The suite must only ever touch the DISPOSABLE database below. Two layers keep
# that true:
#
#   1. tests/bootstrap.php hard-codes DB_DATABASE to `ppdb_sekolah_test`. It
#      never reads the database name from this file — it only warns if this file
#      disagrees, then overrides it. A typo here therefore cannot widen the
#      target; it can only be ignored.
#
#   2. The MySQL user below should be granted ONLY that schema, so even a
#      misconfigured run cannot reach production data:
#
#        CREATE DATABASE ppdb_sekolah_test
#          CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#        CREATE USER 'ppdb_sekolah_test'@'localhost' IDENTIFIED BY 'change-me';
#        GRANT ALL PRIVILEGES ON `ppdb_sekolah_test`.* TO
#          'ppdb_sekolah_test'@'localhost';
#        FLUSH PRIVILEGES;
#
#      Note the backticks around the schema name in the GRANT. Without them,
#      MySQL treats `_` as a single-character wildcard, so the unquoted pattern
#      ppdb_sekolah_test.* also grants access to ppdbXsekolahYtest-like names
#      and is easy to typo into the production schema.
#
# Do NOT point these values at ppdb_sekolah. The tests are destructive.
# ==============================================================================

APP_ENV=testing
APP_NAME="PPDB Sekolah (Testing)"
APP_DEBUG=true

# The disposable test database. Kept in sync with tests/bootstrap.php, which
# hard-codes the same name and overrides anything else.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppdb_sekolah_test
DB_USERNAME=ppdb_sekolah_test
DB_PASSWORD=change-me

# Left empty on purpose. A non-empty DB_URL makes ConfigurationUrlParser merge a
# parsed host/port/database OVER the values above, silently redirecting the
# connection. tests/bootstrap.php clears it in every sink for the same reason.
DB_URL=
DB_SOCKET=

# Fast, isolated, side-effect-free. These keep tests from touching Redis, the
# filesystem cache, or a real mail transport.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local

# bcrypt is the dominant per-test cost; 4 rounds keeps the suite fast while
# still exercising the real hashing code path.
BCRYPT_ROUNDS=4

# ==============================================================================
# B.6A — Daftar Ulang agreement (tests)
# ------------------------------------------------------------------------------
# Tests inject agreement config at runtime via config([...]) (see
# DaftarUlangDomainTest), so these are left BLANK on purpose. Empty config keeps
# invoice creation fail-closed, which several tests rely on. Do not fill these
# with real or fake terms; doing so would make the "missing/blank agreement
# fails closed" assertions depend on env instead of explicit test setup.
# ==============================================================================
DAFTAR_ULANG_AGREEMENT_VERSION=
DAFTAR_ULANG_AGREEMENT_TEXT=
